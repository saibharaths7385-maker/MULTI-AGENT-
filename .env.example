# ---- Model (any OpenAI-compatible endpoint: Groq free tier, Gemini, OpenRouter, Ollama...) ----
LLM_PROVIDER=openai            # openai | anthropic
LLM_BASE_URL=https://api.groq.com/openai/v1   # Ollama: http://localhost:11434/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_key_here      # Ollama: any string
LLM_TIMEOUT_SECONDS=           # defaults to 900 for Ollama, 240 for other providers
SANDBOX=process                # process | docker (docker = real isolation)
MAX_FIX_ROUNDS=3
REQUIRE_APPROVAL=1             # human approval gate after the plan
MAX_ACTIVE_PER_USER=2          # projects one person can run at the same time

# ---- Accounts ----
# Anyone can sign up at /register. No admin password is needed.
# AUTH_SECRET is optional: if empty, Synapse creates one in DATA_DIR and reuses it.
AUTH_SECRET=                    # python -c "import secrets; print(secrets.token_urlsafe(48))"
COOKIE_SECURE=0                 # set to 1 when served over HTTPS (Render: 1)
APP_URL=                        # e.g. https://synapse-agi.onrender.com (Render sets RENDER_EXTERNAL_URL for you)

# ---- Forgot-password email: configure ONE option ----
MAIL_FROM=Synapse <you@example.com>
# Option A: Brevo (free, only needs a verified sender address, works on Render free)
BREVO_API_KEY=
# Option B: Resend (needs a verified domain to email other people)
RESEND_API_KEY=
# Option C: plain SMTP (Gmail app password etc. Render's free plan blocks SMTP ports.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
