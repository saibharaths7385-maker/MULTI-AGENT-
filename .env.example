# Any OpenAI-compatible endpoint works: Groq (free tier), Gemini, OpenRouter, Ollama, etc.
LLM_PROVIDER=openai            # openai | anthropic
LLM_BASE_URL=https://api.groq.com/openai/v1   # Ollama: http://localhost:11434/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_key_here      # Ollama: any string
SANDBOX=process                # process | docker (docker = real isolation)
MAX_FIX_ROUNDS=3
REQUIRE_APPROVAL=1             # human approval gate after the plan
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                 # set a strong password before starting
AUTH_SECRET=                    # generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
COOKIE_SECURE=0                 # set to 1 when served over HTTPS
